     "requires": [{"option": "wov.traffic", "values": ["on"], "reason": {"es": "Necesita Vehículos y tráfico de WoV.", "en": "Needs WoV Vehicles and traffic."}},
                  {"option": "wov.traffic.deformation", "values": ["on"], "else": "game", "reason": {"es": "La deformación de WoV está apagada: queda la del juego.", "en": "WoV deformation is off: the game's stays."}}],
     "values": [
      {"id": "game", "title": {"es": "Juego", "en": "Game"}, "effect": {"rules": [
       {"sources": ["wov", "wovplus"], "kind": "fields", "target": "*vehicles.meta", "fields": ["damageMapScale", "damageOffsetScale"]},
       {"sources": ["wov", "wovplus"], "kind": "fields", "target": "*handling.meta", "fields": ["fCollisionDamageMult", "fWeaponDamageMult", "fDeformationDamageMult"]}]}},
      {"id": "wov", "title": {"es": "WoV", "en": "WoV"}, "effect": {"rules": [
       {"sources": ["wovplus"], "kind": "fields", "target": "*vehicles.meta", "fields": ["damageMapScale", "damageOffsetScale"]},
       {"sources": ["wovplus"], "kind": "fields", "target": "*handling.meta", "fields": ["fCollisionDamageMult", "fWeaponDamageMult", "fDeformationDamageMult"]}]}},
      {"id": "plus", "title": {"es": "Plus", "en": "Plus"}}]},
